APP_NAME="Cloud Based Media File Storage Service"
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):[0-9]+
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloud_storage
CREATE_TABLES_ON_STARTUP=false

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
SECURE_COOKIES=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media-files
STORAGE_PROVIDER=supabase
LOCAL_STORAGE_ROOT=.local-storage
MAX_UPLOAD_SIZE_BYTES=104857600
SIGNED_DOWNLOAD_EXPIRES_IN_SECONDS=900
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,video/mp4,audio/mpeg,text/plain,application/zip

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
